

import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score

     

data = {
    "text": [
        "Government announces new education policy for students",
        "Scientists discover water on Mars after new research",
        "Aliens landed in a university campus in Gujarat last night",
        "Prime Minister addresses the nation on economic growth",
        "Drinking salt water cures all diseases instantly",
        "New technology startup creates affordable electric bikes",
        "Fake currency notes distributed through social media links",
        "India wins international award for renewable energy efforts",
        "Click this link to earn 1 crore rupees in one day",
        "University introduces AI-based learning platform",
        "Vaccines cause people to turn into zombies",
        "Stock market reaches record high this week",
        "Man claims mobile phone can charge itself without electricity",
        "Students develop AI system to detect fake news",
        "Earth will stop rotating next year according to sources"
    ],
    "label": [
        "REAL", "REAL", "FAKE", "REAL", "FAKE",
        "REAL", "FAKE", "REAL", "FAKE", "REAL",
        "FAKE", "REAL", "FAKE", "REAL", "FAKE"
    ]
}

df = pd.DataFrame(data)
